{
  "manifest_version": 2,
  "id": "yayimiko.moss-image",
  "name": "MOSS 绘图",
  "version": "0.2.7",
  "description": "MaiBot 的 MOSS 生图插件：原文直出、漫画/表情包、风格与 OC、图片反推，通过 ComfyUI 发送到 QQ。",
  "author": {"name": "YayiMiko", "url": "https://github.com/YayiMiko"},
  "urls": {"repository": "https://github.com/YayiMiko/maibot_plugin_moss_image"},
  "license": "MIT",
  "plugin_type": "extension",
  "host_application": {"min_version": "1.3.1", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.8.2", "max_version": "2.13.99"},
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "dependencies": [
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28,<1"},
    {"type": "python_package", "name": "requests", "version_spec": ">=2.32,<3"},
    {"type": "python_package", "name": "pillow", "version_spec": ">=11,<13"}
  ],
  "capabilities": ["llm.generate", "send.text", "send.image", "send.forward", "api.call"]
}
